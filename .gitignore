# ===== 流水线产出：只有三个结果表入库 =====
data/processed/*
!data/processed/wide_data.parquet
!data/processed/baseline_carbon.parquet
!data/processed/final_report.parquet
!data/processed/hotspots.parquet
!data/processed/od_band.parquet
!data/processed/ledger.parquet
