!data/processed/run_log.json
!data/processed/_source.json
!data/processed/_mock.flag
# 情景演算页（docs/20 §11）：车队真实统计入库，计算器默认值可复现
!data/processed/fleet_stats.json
# T7 路线情景：路线表与情景表入库（可复现），坐标缓存不入库（机器本地状态）
!data/processed/route_od.parquet
!data/processed/route_carbon.parquet
!data/processed/route_select.parquet
!data/processed/route_candidates.parquet
!data/processed/route_candidate_carbon.parquet
# D4/D5 预计算表（页面只读不算的取数来源，须随结果一起入库）
!data/processed/lambda_curve.parquet
!data/processed/od_vehicle_mix.parquet
!data/processed/route_carbon_od.parquet
!data/processed/composition.json
# O6 方案 × 线路约束表（第 3 页逐线结论的取数来源）
!data/processed/scenario_route_constraint.parquet
data/processed/route_geo.parquet
# 上海—北京 OSM 碳基线（docs/35 D2/D3）：非实时 · 固定因子 · 道路等级 proxy
!data/processed/route_baseline_sh_bj_steps.parquet
!data/processed/route_baseline_sh_bj_summary.json

