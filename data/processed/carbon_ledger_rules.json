{
  "validation_rules": [
    {
      "Rule_ID": "CTRL-01",
      "Control": "Required fields",
      "Trigger/Logic": "Activity value/unit and EF value/unit plus Trip_ID, vehicle/date, activity type, distance/cargo, evidence ID, run_id and source ledger row must be present",
      "Action": "Block calculation; emit no numeric result",
      "Summary treatment": "Excluded until corrected",
      "State": "Implemented in AJ/AK; missing physical identity/evidence fields are blocked"
    },
    {
      "Rule_ID": "CTRL-02",
      "Control": "Negative activity",
      "Trigger/Logic": "Activity_Value < 0",
      "Action": "Block calculation and flag for review",
      "Summary treatment": "Excluded until corrected",
      "State": "Implemented in AJ/AK and Test_Cases"
    },
    {
      "Rule_ID": "CTRL-03",
      "Control": "Unit mismatch",
      "Trigger/Logic": "Activity unit denominator does not match EF unit",
      "Action": "Block calculation",
      "Summary treatment": "Excluded until corrected",
      "State": "Implemented in AJ/AK and Test_Cases"
    },
    {
      "Rule_ID": "CTRL-04",
      "Control": "Duplicate ledger ID",
      "Trigger/Logic": "Ledger_Row_ID appears more than once",
      "Action": "Block/flag duplicate row",
      "Summary treatment": "Do not sum duplicate",
      "State": "Implemented in AJ/AK and Test_Cases"
    },
    {
      "Rule_ID": "CTRL-05",
      "Control": "Formal use gate",
      "Trigger/Logic": "Simulated flag or proxy factor status or missing evidence identifiers",
      "Action": "NOT_FORMAL_USE",
      "Summary treatment": "Never formal reporting",
      "State": "Implemented in AL"
    },
    {
      "Rule_ID": "CTRL-06",
      "Control": "Waybill allocation sum",
      "Trigger/Logic": "Shares for a Trip_ID sum to 1 ± 0.000001",
      "Action": "Pass only if share sum=1; otherwise block",
      "Summary treatment": "Mapping view only; Trip_Detail remains sole sum source",
      "State": "Implemented in Waybill_Detail P"
    },
    {
      "Rule_ID": "CTRL-07",
      "Control": "No duplicate aggregation",
      "Trigger/Logic": "Segment_Detail/Waybill_Detail reference Trip_Detail, do not add into total",
      "Action": "Use Trip_Detail only",
      "Summary treatment": "Avoid double count",
      "State": "Documented and tested"
    },
    {
      "Rule_ID": "CTRL-08",
      "Control": "Four vehicle deviation sample",
      "Trigger/Logic": "Historical sample specified by lead is deferred",
      "Action": "No computation, no inclusion",
      "Summary treatment": "Separate pending status only",
      "State": "Guard retained; no values stored"
    },
    {
      "Rule_ID": "CTRL-09",
      "Control": "Evidence chain",
      "Trigger/Logic": "Evidence ID, invoice placeholder, run_id, ledger row ID map together",
      "Action": "Flag missing or mismatched chain",
      "Summary treatment": "No formal trace claim if placeholder",
      "State": "Self-check script validates linkage"
    },
    {
      "Rule_ID": "CTRL-10",
      "Control": "Factor provenance",
      "Trigger/Logic": "Each EF links to Source_Register and status",
      "Action": "Unverified proxy blocks formal use",
      "Summary treatment": "Simulated only",
      "State": "Source register row 5 / SRC-004 pending verification"
    },
    {
      "Rule_ID": "CTRL-11",
      "Control": "Unit whitelist",
      "Trigger/Logic": "Activity unit must be one of L, kWh, km, t AND EF unit must match exact expected unit",
      "Action": "Block unsupported activity unit or mismatch",
      "Summary treatment": "Exclude until corrected",
      "State": "Implemented in AJ; `m³` and other unknown units blocked"
    },
    {
      "Rule_ID": "CTRL-12",
      "Control": "Physical trip duplicate candidates",
      "Trigger/Logic": "Duplicate Trip_ID, Source_Ledger_Row_No, or fingerprint (Vehicle + Date + Activity + Distance + Cargo + Activity value + Unit)",
      "Action": "Block candidate until owner reviews source/run logs",
      "Summary treatment": "Exclude/freeze pending review",
      "State": "Implemented in AM/AN/AJ; candidate key is conservative heuristic, not proof of duplicate"
    },
    {
      "Rule_ID": "CTRL-13",
      "Control": "Formal summary eligibility",
      "Trigger/Logic": "Status must be actual, simulated != yes, factor verified, all evidence keys present, precheck and physical uniqueness pass, owner approval status approved",
      "Action": "Formal summaries include only FORMAL_APPROVED rows",
      "Summary treatment": "No approved rows => zero total plus NO_APPROVED_ROWS status",
      "State": "Implemented in AO/AP and Formal_Monthly_Summary/Formal_Annual_Summary"
    },
    {
      "Rule_ID": "CTRL-14",
      "Control": "Physical identity required fields",
      "Trigger/Logic": "Vehicle_ID, Trip_Date, Activity_Type, Distance, Cargo, Trip_ID, Evidence_ID, Run_ID and source ledger row must exist",
      "Action": "Block calculation; emit no numeric result",
      "Summary treatment": "Exclude until completed",
      "State": "Implemented in AJ/AK; missing Vehicle_ID test PT-019"
    }
  ],
