# ==========================================================================
# 物流企业碳感知智能决策系统 · 内网 TLS 网关（Caddy 2）
#
#   https://<SITE_ADDRESS>:8443  HTTPS 统一入口（内网自签 CA：tls internal）
#   :8080  明文入口，只做 308 跳转到 HTTPS
#   /api/* → sensor:5000   ESP32 只需打 https://<主机>:8443/api/upload_obd_gps
#   其它   → app:8501      Streamlit 决策台（websocket 由 Caddy 默认透传）
#
# 环境变量：
#   HTTPS_PORT    —— 对外 HTTPS 端口（compose 注入）。只用于 8080 跳转目标；
#                   容器内监听端口固定 8443，宿主端口由 compose 做映射。
#   HTTP_PORT     —— 对外 HTTP 端口，当前仅作记录用。
#   SITE_ADDRESS —— 部署机对内 IP 或内网域名，进证书 SAN；默认 127.0.0.1。
#
# 证书信任（内网自签，首次访问浏览器会告警）：
#   docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt > root.crt
#   然后在客户端把 root.crt 导入系统信任库（详见 deploy/README.md）。
# ==========================================================================

# 无 SNI 客户端（含按 IP 访问的浏览器、跳过校验的 ESP32）回落到 SITE_ADDRESS；
# Caddy 为 localhost / caddy / SITE_ADDRESS 分别签发内网证书。
{
	default_sni {$SITE_ADDRESS:127.0.0.1}
}

# ---- HTTPS 主入口 ----------------------------------------------------
https://localhost:8443, https://caddy:8443, https://{$SITE_ADDRESS:127.0.0.1}:8443, https://:8443 {
	# 内网自签 CA：证书由 Caddy 自建并存放在 caddy_data 命名卷里
	tls internal

	# 传感器网关：ESP32 / 单片机走这一条路径
	handle /api/* {
		reverse_proxy sensor:5000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# 其余路径全部交给 Streamlit 决策台
	handle {
		reverse_proxy app:8501 {
			# 关闭响应缓冲：保证 Streamlit 的增量渲染不被攒包
			flush_interval -1
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# ---- 明文入口：只跳转，不承载业务 -------------------------------------
http://:8080 {
	# 308 保留请求方法（POST 跳转不会退化成 GET）
	redir https://{host}:{$HTTPS_PORT:8443}{uri} 308
}
