# ==========================================================================
# 物流企业碳感知智能决策系统 · 容器化部署环境变量样例
#
# 用法：
#   cp deploy/env.example deploy/env      # 然后填入真实值
#   docker compose --env-file deploy/env up -d --build
#
# 优先级（compose 插值）：宿主 shell 环境变量 > --env-file 指定的文件 > compose 默认值
#
# 纪律：
#   · deploy/env 里装的是真实密钥，**不要**提交进 git（它不在仓库里，
#     只存在于部署机上；deploy/env.example 才是入库的那一份）；
#   · 密钥也可以只读挂载宿主 config/*_key.txt 进容器（见 deploy/README.md）；
#   · 镜像内不含任何密钥文件。
# ==========================================================================

# --------------------------------------------------------------------------
# 高德地图 · Web 服务 Key（服务端 REST 调用用，src/routing/amap_client.py）
# --------------------------------------------------------------------------
AMAP_WEB_SERVICE_KEY=

# --------------------------------------------------------------------------
# 高德地图 · JS API Key（浏览器端渲染地图用，src/routing/amap_js.py）
# 注意：代码实际读取的环境变量名是 AMAP_JS_API_KEY
# --------------------------------------------------------------------------
AMAP_JS_API_KEY=

# 兼容别名：当前代码**不读取**这个变量，填了不生效（保留仅为对齐旧文档）
AMAP_JS_KEY=

# --------------------------------------------------------------------------
# 高德地图 · JS 安全密钥（与 JS API Key 配对使用）
# --------------------------------------------------------------------------
AMAP_JS_SECURITY_CODE=

# --------------------------------------------------------------------------
# DeepSeek · 发票 OCR 大模型 Key（app/live_services.py）
# --------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# --------------------------------------------------------------------------
# 传感器网关（server.py）· 设备鉴权 / CORS / 限流
# 默认 fail-closed：请求必须带 X-Device-Token，且设备已登记到 devices.json。
# --------------------------------------------------------------------------
# 是否要求设备鉴权（1 开 / 0 关；0 仅限本机演示，不得暴露公网）
SENSOR_AUTH=1
# 允许的跨域来源，逗号分隔；留空表示不发跨域头，不等于接口无鉴权
SENSOR_ALLOWED_ORIGINS=
# 设备注册表路径（容器内默认 /app/config/devices.json）
SENSOR_DEVICES_FILE=/app/config/devices.json
# 单设备每分钟请求上限（默认 60 次/分钟）
SENSOR_RATE_LIMIT_PER_MIN=60

# --------------------------------------------------------------------------
# 演示 / 离线开关
# SENSOR_MOCK=0 : 关闭传感器演示序列，页面回到「等待真实读数」状态
# INVOICE_OCR_MOCK=1 : 发票识别走离线演示，不调用大模型
# --------------------------------------------------------------------------
SENSOR_MOCK=1
INVOICE_OCR_MOCK=0

# --------------------------------------------------------------------------
# 端口（宿主侧端口 → 容器内固定端口）
#   APP_PORT     8501 : Streamlit 决策台直连端口
#   SENSOR_PORT  5000 : 传感器网关直连端口
#   HTTP_PORT    8080 : Caddy 明文入口（只做跳转）
#   HTTPS_PORT   8443 : Caddy HTTPS 入口（统一入口）
# --------------------------------------------------------------------------
APP_PORT=8501
SENSOR_PORT=5000
HTTP_PORT=8080
HTTPS_PORT=8443

# --------------------------------------------------------------------------
# 镜像名（compose 用它给 build 出来的镜像打标签）
# --------------------------------------------------------------------------
IMAGE_NAME=carbontide:latest

# --------------------------------------------------------------------------
# 时区
# --------------------------------------------------------------------------
TZ=Asia/Shanghai
